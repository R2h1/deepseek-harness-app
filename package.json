{
  "name": "dsh-desktop",
  "version": "0.1.1",
  "private": true,
  "description": "ElectroBun desktop shell for the DeepSeek Harness Web GUI",
  "scripts": {
    "start": "electrobun run",
    "dev": "electrobun dev",
    "dev:watch": "electrobun dev --watch",
    "build:dev": "bun install && electrobun build",
    "build:canary": "electrobun build --env=canary",
    "build:stable": "electrobun build --env=stable",
    "build:installer": "node scripts/build-installer.mjs",
    "build:portable": "electrobun build --env=stable && node scripts/embed-installer.mjs",
    "publish:release": "node scripts/publish-release.mjs",
    "test:mobile": "bun scripts/test-mobile.ts",
    "test:mobile:real": "bun scripts/test-mobile-real.ts",
    "test:tunnel": "bun scripts/test-tunnel.ts",
    "gen:icons": "bun scripts/gen-icons.mjs",
    "backend:provision": "node scripts/provision-backend.mjs",
    "backend:pin": "node scripts/provision-backend.mjs --version",
    "backend:check": "node scripts/check-backend-version.mjs"
  },
  "dependencies": {
    "electrobun": "^1.18.1"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/bun": "latest",
    "rcedit": "^5.0.2"
  }
}
